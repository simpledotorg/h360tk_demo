HEART360TK_VERSION=h360-207
POSTGRES_HOST=postgres
POSTGRES_DB=heart360tk_database
is_central_node=true
SOURCE_KEY=h360tk_demo
# EXPORT_CRON=0 * * * *
# UPLOAD_PROTOCOL=file
# UPLOAD_DEST_PATH=/export

# SFTPGo process uid:gid — must match the user:group that owns ./.upload on the host (see `id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000

# FTP passive mode: must match the host clients use in ftp://HOST:2121 (see docker-compose sftpgo).
# Local only: 127.0.0.1. Same host for dev + LAN clients: set to this machine's LAN IP and use that in URLs.
# Internet: set to the server's public IP (and open 2121 + 50000-50100 on the firewall / NAT).
FTP_PASSIVE_IP=127.0.0.1

# -----------------------------------------------------------------------------
# Exporter: S3 upload (set UPLOAD_PROTOCOL=s3 to enable)
# -----------------------------------------------------------------------------
# S3_BUCKET=your-bucket-name
# S3_KEY_PREFIX=uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT_URL=your-s3-endpoint-url            

# -----------------------------------------------------------------------------
# Local SFTP server (atmoz/sftp — see docker-compose sftp-server service)
# Files land in ./sftp-inbox on the host.
# Change credentials here; the sftp-server container picks them up on restart.
# -----------------------------------------------------------------------------
SFTP_HOST=sftp-server
SFTP_PORT=22
SFTP_USER=sftpuser
SFTP_PASSWORD=sftppass
SFTP_DEST_PATH=/upload
SFTP_TIMEOUT=60

# -----------------------------------------------------------------------------
# Exporter: SFTP upload (set UPLOAD_PROTOCOL=sftp to enable)
# -----------------------------------------------------------------------------
# Uncomment the line below and set UPLOAD_PROTOCOL=sftp to push exports to the
# local SFTP server defined above.
# UPLOAD_PROTOCOL=sftp

# -----------------------------------------------------------------------------
# IMPORTER
# -----------------------------------------------------------------------------
IMPORT_CRON=*/2 * * * *
IMPORT_PROTOCOL=sftp
IMPORT_AGGREAGATE_DATA=true
IMPORT_FOLDER_PATH=/upload