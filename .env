HEART360TK_VERSION=0.5.0
POSTGRES_HOST=postgres
POSTGRES_DB=heart360tk_database
POSTGRES_USER=heart360tk
POSTGRES_PASSWORD=YmE4ZTk0OGI0OTNmNGU5YmFjZDY1YTA0


# SFTPGo process uid:gid — must match the user:group that owns ./.upload on the host (see `id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000

# FTP passive mode: must match the host clients use in ftp://HOST:2121 (see docker-compose sftpgo).
# Local only: 127.0.0.1. Same host for dev + LAN clients: set to this machine's LAN IP and use that in URLs.
# Internet: set to the server's public IP (and open 2121 + 50000-50100 on the firewall / NAT).
FTP_PASSIVE_IP=127.0.0.1
       

# -----------------------------------------------------------------------------
# SFTP upload (set UPLOAD_PROTOCOL=sftp to enable)
# -----------------------------------------------------------------------------
SFTP_HOST=13.200.116.124
SFTP_PORT=2222
SFTP_USER=h360tk_sftp
SFTP_PASSWORD=He8u^%gtRG36&^hgtyc97
SFTP_DEST_PATH=/upload
SFTP_TIMEOUT=60

# -----------------------------------------------------------------------------
# EXPORTER
# -----------------------------------------------------------------------------
SOURCE_KEY=h360tk_demo
EXPORT_CRON=5 * * * *     # Runs 5 min after the hourly refresh (0 * * * *), ensuring export reads fully-refreshed data instead of racing the refresh job
UPLOAD_PROTOCOL=sftp


# -----------------------------------------------------------------------------
# Local upload destination path 
# -----------------------------------------------------------------------------
# UPLOAD_DEST_PATH=/export


# -----------------------------------------------------------------------------
# S3 upload (set UPLOAD_PROTOCOL=s3 to enable)
# -----------------------------------------------------------------------------
# S3_BUCKET=your-bucket-name
# S3_KEY_PREFIX=uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT_URL=your-s3-endpoint-url     
# --- Path-based routing -----------------------------------------------------
# This instance is served at <scheme>://<domain><base path>/ behind the shared
# edge for toolkit.hearts360.org. Base path has no trailing slash.
# The proxy and filebrowser images derive their own config from these at
# container start, so there is nothing else to keep in sync.
H360TK_BASE_PATH=/demo
H360TK_PUBLIC_DOMAIN=toolkit.hearts360.org
H360TK_PUBLIC_SCHEME=https
# Host port the instance proxy listens on. The ALB target group for this
# instance must point here - not at 3000, or it routes straight past the proxy
# to Grafana and /demo/upload/ 404s. Health check path: /healthz.
H360TK_PROXY_PORT=80
#
# Testing by hitting the box directly rather than through the ALB? Grafana's
# absolute links point at the public HTTPS URL, which does not reach the box.
# Uncomment and fill in the host so they match what you browse:
#   H360TK_PUBLIC_SCHEME=http
#   H360TK_PUBLIC_DOMAIN=<demo-ec2-host>
# Leave both as they are when testing through toolkit.hearts360.org.
# Running locally? Set H360TK_PUBLIC_DOMAIN=localhost and H360TK_PUBLIC_SCHEME=http
# so Grafana builds correct absolute links, and change H360TK_PROXY_PORT if port
# 80 is taken.
